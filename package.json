{
  "name": "upsite",
  "version": "1.0.0",
  "private": true,
  "description": "Uptime monitoring on GitHub Actions, with git as the database and GitHub Pages as the status site.",
  "scripts": {
    "dev": "UPSITE_BASE_PATH= next dev",
    "build": "next build",
    "preview": "UPSITE_BASE_PATH= next build && npx serve out",
    "start": "npm run preview",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "uptime": "tsx scripts/uptime.ts",
    "response-time": "tsx scripts/response-time.ts",
    "graphs": "tsx scripts/graphs.ts",
    "summary": "tsx scripts/summary.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "tsx": "^4.19.2"
  }
}
