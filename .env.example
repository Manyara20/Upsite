# Copy to .env.local for running the workflow scripts by hand. Never commit it.
#
# In GitHub Actions none of this is a file: GITHUB_TOKEN is injected by the
# runner, and SLACK_WEBHOOK_URL comes from repository secrets.

# Enables the GitHub issue lifecycle — opening, commenting on, locking and
# closing incidents. Without it the scripts do everything except talk to
# GitHub, which is what makes them safe to run locally.
# Needs `repo` scope (or `public_repo` for a public repository).
GITHUB_TOKEN=

# Slack incoming webhook. A Discord webhook URL works here too — the payload
# carries a `text` fallback that both accept.
SLACK_WEBHOOK_URL=

# Optional overrides
# UPSITE_CONFIG=./upsite.config.yaml
# Overrides site.basePath at build time. The site workflow sets this from
# actions/configure-pages, so a custom domain needs no config change.
# UPSITE_BASE_PATH=
