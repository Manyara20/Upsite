# Copy to .env.local and edit. Never commit .env.local.

# Password for the secure tab. Without this, the tab renders a
# "not configured" notice — secure monitors are still checked on schedule,
# but nobody can view them.
UPSITE_SECURE_PASSWORD=change-me

# Signs the unlock cookie. Generate with: openssl rand -hex 32
# If unset, a random secret is generated per process, so every restart logs
# everyone out. Set it in production.
UPSITE_SECRET=

# Set to 1 when serving over HTTPS so the unlock cookie is marked Secure.
# Leave unset on plain HTTP or the cookie will never be sent back.
UPSITE_COOKIE_SECURE=

# Require `Authorization: Bearer <token>` on POST /api/reload.
UPSITE_ADMIN_TOKEN=

# Protects GET /api/cron. Vercel sends this automatically as a Bearer token
# when set; any external scheduler should send it too.
CRON_SECRET=

# Optional overrides
# UPSITE_CONFIG=./upsite.config.yaml
# UPSITE_DATA_DIR=./.data

# Force serverless mode (1) or force the internal scheduler on (0).
# Auto-detected from VERCEL / AWS_LAMBDA_FUNCTION_NAME / NETLIFY.
# UPSITE_EPHEMERAL=

# Referenced by upsite.config.yaml if you enable Slack/Discord alerts.
SLACK_WEBHOOK_URL=
